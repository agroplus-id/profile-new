# Salin ke .env lalu isi dari Firebase Console > Project settings > Your apps > Web app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=modifikasi-agropluss-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=modifikasi-agropluss-id
VITE_FIREBASE_STORAGE_BUCKET=modifikasi-agropluss-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Server only (JANGAN pakai awalan VITE_) ---
# API alat Ferroir untuk mengisi data Coffee Passport. Isi "mock" untuk data contoh saat uji coba.
FERROIR_API_URL=
FERROIR_API_KEY=
# Email admin yang boleh memanggil /api/ferroir, pisahkan dengan koma
ADMIN_EMAILS=
