rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Daftar email admin. Tambah email lain di dalam list bila perlu.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['agroplusindonesia@gmail.com'];
    }

    // Konten publik: boleh dibaca siapa saja, hanya admin yang boleh mengubah.
    match /team/{id}         { allow read: if true; allow write: if isAdmin(); }
    match /updates/{id}      { allow read: if true; allow write: if isAdmin(); }
    match /testimonials/{id} { allow read: if true; allow write: if isAdmin(); }
    match /settings/{id}     { allow get: if true; allow list, write: if isAdmin(); }
    match /press/{id}        { allow read: if true; allow write: if isAdmin(); }
    match /partners/{id}     { allow read: if true; allow write: if isAdmin(); }

    // Gambar batch (hero, foto pendukung, paspor, foto lokasi): dibaca satu per satu; ubah hanya admin.
    match /batchImages/{id} {
      allow get: if true;
      allow list, create, update, delete: if isAdmin();
    }

    // Isi artikel berita & cerita testimoni (HTML): dibaca per artikel; daftar dan ubah hanya admin.
    match /articles/{id} {
      allow get: if true;
      allow list, create, update, delete: if isAdmin();
    }
    match /testimonialArticles/{id} {
      allow get: if true;
      allow list, create, update, delete: if isAdmin();
    }

    // Penghitung nomor paspor (hanya admin).
    match /counters/{id} { allow read, write: if isAdmin(); }

    // Pesanan CoffeeID: pelanggan hanya bisa mengambil SATU dokumen bila tahu kode pesanannya
    // (kode = ID dokumen). Daftar lengkap dan semua perubahan hanya untuk admin.
    // Batch kopi: dibaca satu per satu lewat kode batch dari data pesanan; daftar & ubah hanya admin.
    // Daftar dibuka untuk publik agar kode kemasan bisa dicari (isi batch memang sudah tampil di halaman publik).
    match /batches/{code} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    match /orders/{code} {
      allow get: if true;
      // Pelanggan yang sudah login (dan emailnya terverifikasi) boleh melihat daftar pesanan atas emailnya sendiri.
      allow list: if isAdmin()
        || (request.auth != null
            && request.auth.token.email_verified == true
            && resource.data.email == request.auth.token.email.lower());
      allow create, update, delete: if isAdmin();
    }

    // Riwayat pengumuman email yang dikirim admin.
    match /broadcasts/{id} { allow read, write: if isAdmin(); }

    // Akun pelanggan: hanya pemiliknya (uid sama) yang boleh membaca/mengubah; admin boleh membaca untuk daftar
    // pelanggan dan pengiriman pengumuman.
    match /users/{uid} {
      allow get, create, update, delete: if request.auth != null && request.auth.uid == uid;
      allow get, list: if isAdmin();

      match /addresses/{id} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
        allow read: if isAdmin();
      }
    }
  }
}
